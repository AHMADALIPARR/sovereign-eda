// Malbolge ternary kernels, V2. Benchmark variant. V1 is untouched.
//
// Three changes, all from the v1 review:
//   1. crazy_op uses bfe.u32: the shr + and pair collapses to one
//      bfe.u32 res, lut, sh, 2. (crazy_op_bfe below, and the scalar
//      kernel inlines it.)
//   2. The SWAR kernel (ternary_tryte_kernel_v2) evaluates all 10
//      trits in parallel from the 0x55555 / 0xAAAAA bitplanes. No
//      10-iteration loop, no per-lane call.
//   3. The scalar kernel (ternary_tryte_kernel_v2_scalar) keeps the
//      10-iteration loop but INLINES the op bodies: no call
//      instructions anywhere in v2. This is the middle benchmark
//      point between v1 (loop + calls) and v2 SWAR (no loop).
//
// tryteToNat is not in this file: v1 PTX has no tryteToNat either
// (the kernel only does the elementwise trit ops). The endianness
// fix lives in the CUDA v2 file and the Lean v2 file.
// .version 7.0
.target sm_70
.address_size 64

// Lean: crazyOp (a b : Trit) : Trit (LUT = 0x00281A01), with bfe.
// Replaces shr.u32 + and.b32 with a single bfe.u32.
.func (.reg .u32 res) crazy_op_bfe(.reg .u32 a, .reg .u32 b)
{
    .reg .u32 k, sh, lut;

    and.b32     a, a, 3;
    and.b32     b, b, 3;
    shl.b32     k, a, 2;
    or.b32      k, k, b;
    shl.b32     sh, k, 1;
    mov.u32     lut, 0x00281A01;
    bfe.u32     res, lut, sh, 2;
    ret;
}

// Packed 10-trit Tryte Kernel, V2 scalar (inlined loop, no calls)
// op: 0 = tritAdd, 1 = tritSub, 2 = crazyOp, 3 = permuteTryte
.visible .entry ternary_tryte_kernel_v2_scalar(
    .param .u64 param_A,
    .param .u64 param_B,
    .param .u64 param_C,
    .param .u32 param_op,
    .param .u32 param_n
)
{
    .reg .pred p_oob, p_perm, p_loop, p_op0, p_op1;
    .reg .u32  tid, bdim, ctaid, idx, n, op;
    .reg .u32  va, vb, res, i, sh, ta, tb, tr;
    .reg .u32  rot_lo, rot_hi, tmp;
    .reg .u32  s, s_sub, d, d_sub, k, lut;
    .reg .u64  addrA, addrB, addrC, off;

    ld.param.u64 addrA, [param_A];
    ld.param.u64 addrB, [param_B];
    ld.param.u64 addrC, [param_C];
    ld.param.u32 op,    [param_op];
    ld.param.u32 n,     [param_n];

    mov.u32      ctaid, %ctaid.x;
    mov.u32      bdim,  %ntid.x;
    mov.u32      tid,   %tid.x;
    mad.lo.u32   idx, ctaid, bdim, tid;
    setp.ge.u32  p_oob, idx, n;
    @p_oob bra   DONE_SCALAR;

    mul.wide.u32 off, idx, 4;
    add.u64      addrA, addrA, off;
    add.u64      addrB, addrB, off;
    add.u64      addrC, addrC, off;

    ld.global.u32 va, [addrA];
    ld.global.u32 vb, [addrB];
    and.b32       va, va, 0x000FFFFF;
    and.b32       vb, vb, 0x000FFFFF;

    // If op == 3 (permuteTryte), rotateLeft1 before loop and set vb = va
    setp.eq.u32  p_perm, op, 3;
    @!p_perm bra INIT_LOOP_SCALAR;
    shr.u32      rot_lo, va, 2;
    and.b32      rot_lo, rot_lo, 0x0003FFFF;
    and.b32      rot_hi, va, 3;
    shl.b32      rot_hi, rot_hi, 18;
    or.b32       va, rot_lo, rot_hi;
    mov.u32      vb, va;

INIT_LOOP_SCALAR:
    mov.u32      res, 0;
    mov.u32      i, 0;

LOOP_TRITS_SCALAR:
    shl.b32      sh, i, 1;
    shr.u32      ta, va, sh;
    and.b32      ta, ta, 3;
    shr.u32      tb, vb, sh;
    and.b32      tb, tb, 3;

    setp.eq.u32  p_op0, op, 0;
    setp.eq.u32  p_op1, op, 1;
    @p_op0 bra   DO_ADD_SCALAR;
    @p_op1 bra   DO_SUB_SCALAR;
    bra          DO_CRAZY_SCALAR;

DO_ADD_SCALAR:
    // inlined trit_add
    add.u32     s, ta, tb;
    setp.ge.u32 p_op0, s, 3;
    sub.u32     s_sub, s, 3;
    selp.u32    tr, s_sub, s, p_op0;
    bra MERGE_TRIT_SCALAR;

DO_SUB_SCALAR:
    // inlined trit_sub
    add.u32     s, ta, 3;
    sub.u32     d, s, tb;
    setp.ge.u32 p_op0, d, 3;
    sub.u32     d_sub, d, 3;
    selp.u32    tr, d_sub, d, p_op0;
    bra MERGE_TRIT_SCALAR;

DO_CRAZY_SCALAR:
    // inlined crazy_op with bfe
    shl.b32     k, ta, 2;
    or.b32      k, k, tb;
    shl.b32     sh, k, 1;
    mov.u32     lut, 0x00281A01;
    bfe.u32     tr, lut, sh, 2;

MERGE_TRIT_SCALAR:
    shl.b32      tmp, tr, sh;
    or.b32       res, res, tmp;
    add.u32      i, i, 1;
    setp.lt.u32  p_loop, i, 10;
    @p_loop bra  LOOP_TRITS_SCALAR;

    and.b32      res, res, 0x000FFFFF;
    st.global.u32 [addrC], res;

DONE_SCALAR:
    ret;
}

// Packed 10-trit Tryte Kernel, V2 SWAR (no loop, no calls)
// op: 0 = tritAdd, 1 = tritSub, 2 = crazyOp, 3 = permuteTryte
.visible .entry ternary_tryte_kernel_v2(
    .param .u64 param_A,
    .param .u64 param_B,
    .param .u64 param_C,
    .param .u32 param_op,
    .param .u32 param_n
)
{
    .reg .pred p_oob, p_op0, p_op1, p_op2;
    .reg .u32  tid, bdim, ctaid, idx, n, op;
    .reg .u32  va, vb, res;
    .reg .u32  a0, a1, b0, b1, na0, na1, nb0, nb1;
    .reg .u32  r1, r0, t1, t2, t3, tmp;
    .reg .u64  addrA, addrB, addrC, off;

    ld.param.u64 addrA, [param_A];
    ld.param.u64 addrB, [param_B];
    ld.param.u64 addrC, [param_C];
    ld.param.u32 op,    [param_op];
    ld.param.u32 n,     [param_n];

    mov.u32      ctaid, %ctaid.x;
    mov.u32      bdim,  %ntid.x;
    mov.u32      tid,   %tid.x;
    mad.lo.u32   idx, ctaid, bdim, tid;
    setp.ge.u32  p_oob, idx, n;
    @p_oob bra   DONE_SWAR;

    mul.wide.u32 off, idx, 4;
    add.u64      addrA, addrA, off;
    add.u64      addrB, addrB, off;
    add.u64      addrC, addrC, off;

    ld.global.u32 va, [addrA];
    ld.global.u32 vb, [addrB];
    and.b32       va, va, 0x000FFFFF;
    and.b32       vb, vb, 0x000FFFFF;

    // op == 3 (permuteTryte): rotateLeft1, then crazyOp(x, x)
    setp.eq.u32  p_op2, op, 3;
    @!p_op2 bra  BITPLANES;
    shr.u32      tmp, va, 2;
    and.b32      tmp, tmp, 0x0003FFFF;
    and.b32      t1, va, 3;
    shl.b32      t1, t1, 18;
    or.b32       va, tmp, t1;
    mov.u32      vb, va;

BITPLANES:
    // bitplanes: a0/a1 and b0/b1 at even positions 0,2,...,18
    and.b32     a0, va, 0x00055555;
    shr.u32     tmp, va, 1;
    and.b32     a1, tmp, 0x00055555;
    and.b32     b0, vb, 0x00055555;
    shr.u32     tmp, vb, 1;
    and.b32     b1, tmp, 0x00055555;
    not.b32     na0, a0;
    not.b32     na1, a1;
    not.b32     nb0, b0;
    not.b32     nb1, b1;

    setp.eq.u32  p_op0, op, 0;
    setp.eq.u32  p_op1, op, 1;
    @p_op0 bra   SWAR_ADD;
    @p_op1 bra   SWAR_SUB;
    bra          SWAR_CRAZY;

SWAR_ADD:
    // r1 = (~a1 & ~a0 & b1) | (~a1 & a0 & b0 & ~b1) | (a1 & ~b1 & ~b0)
    and.b32     t1, na1, na0;
    and.b32     t1, t1, b1;
    and.b32     t2, na1, a0;
    and.b32     t2, t2, b0;
    and.b32     t2, t2, nb1;
    and.b32     t3, a1, nb1;
    and.b32     t3, t3, nb0;
    or.b32      r1, t1, t2;
    or.b32      r1, r1, t3;
    // r0 = (~a1 & ~a0 & b0 & ~b1) | (~a1 & a0 & ~b1 & ~b0) | (a1 & b1)
    and.b32     t1, na1, na0;
    and.b32     t1, t1, b0;
    and.b32     t1, t1, nb1;
    and.b32     t2, na1, a0;
    and.b32     t2, t2, nb1;
    and.b32     t2, t2, nb0;
    and.b32     t3, a1, b1;
    or.b32      r0, t1, t2;
    or.b32      r0, r0, t3;
    bra         COMBINE;

SWAR_SUB:
    // r1 = (a1 & ~b1 & ~b0) | (~a1 & ~a0 & b0 & ~b1) | (~a1 & a0 & b1)
    and.b32     t1, a1, nb1;
    and.b32     t1, t1, nb0;
    and.b32     t2, na1, na0;
    and.b32     t2, t2, b0;
    and.b32     t2, t2, nb1;
    and.b32     t3, na1, a0;
    and.b32     t3, t3, b1;
    or.b32      r1, t1, t2;
    or.b32      r1, r1, t3;
    // r0 = (~a1 & a0 & ~b1 & ~b0) | (a1 & b0 & ~b1) | (~a1 & ~a0 & b1)
    and.b32     t1, na1, a0;
    and.b32     t1, t1, nb1;
    and.b32     t1, t1, nb0;
    and.b32     t2, a1, b0;
    and.b32     t2, t2, nb1;
    and.b32     t3, na1, na0;
    and.b32     t3, t3, b1;
    or.b32      r0, t1, t2;
    or.b32      r0, r0, t3;
    bra         COMBINE;

SWAR_CRAZY:
    // r1 = (a0 & ~a1 & ~b1) | (a1 & ~b1 & b0) | (a1 & b1 & ~b0)
    and.b32     t1, a0, na1;
    and.b32     t1, t1, nb1;
    and.b32     t2, a1, nb1;
    and.b32     t2, t2, b0;
    and.b32     t3, a1, b1;
    and.b32     t3, t3, nb0;
    or.b32      r1, t1, t2;
    or.b32      r1, r1, t3;
    // r0 = (~a1 & ~a0 & ~b1 & ~b0) | (~a1 & a0 & b1)
    and.b32     t1, na1, na0;
    and.b32     t1, t1, nb1;
    and.b32     t1, t1, nb0;
    and.b32     t2, na1, a0;
    and.b32     t2, t2, b1;
    or.b32      r0, t1, t2;
    bra         COMBINE;

COMBINE:
    // Confine r1/r0 to the even bitplane: a term made only of
    // complements (crazy r0) is all ones without this mask.
    and.b32     r1, r1, 0x00055555;
    and.b32     r0, r0, 0x00055555;
    shl.b32     r1, r1, 1;
    or.b32      res, r1, r0;
    and.b32     res, res, 0x000FFFFF;
    st.global.u32 [addrC], res;

DONE_SWAR:
    ret;
}
