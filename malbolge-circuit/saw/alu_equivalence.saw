// Requires GHDL+Yosys with the ghdl plugin; see Makefile.
// Paths are relative to this script's directory (saw/).
enable_experimental;
import "../cryptol/MalbolgeCore.cry";
m <- yosys_import "../build/malbolge_alu.json";
alu_correct <- yosys_verify {{ m.malbolge_alu }} [] {{ aluSpec }} [] w4;
