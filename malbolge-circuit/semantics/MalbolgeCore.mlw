module MalbolgeCore
  use int.Int
  use int.ComputerDivision

  let constant modulus : int = 59049
  predicate word (x:int) = 0 <= x < modulus
  predicate trit (x:int) = 0 <= x < 3

  let function crazy_trit (a:int) (d:int) : int
    requires { trit a /\ trit d }
    ensures  { trit result }
    ensures  { d = 0 -> result = (if a = 0 then 1 else 0) }
    ensures  { d = 1 -> result = (if a = 0 then 1 else if a = 1 then 0 else 2) }
    ensures  { d = 2 -> result = (if a = 2 then 1 else 2) }
  = if d = 0 then (if a = 0 then 1 else 0)
    else if d = 1 then (if a = 0 then 1 else if a = 1 then 0 else 2)
    else (if a = 2 then 1 else 2)

  let function rotate (x:int) : int
    requires { word x }
    ensures  { word result }
    ensures  { result = div x 3 + (mod x 3) * 19683 }
  = div x 3 + (mod x 3) * 19683

  let function decode (c:int) (cell:int) : int
    requires { word c /\ word cell }
    ensures  { 0 <= result < 94 }
  = mod (c + cell) 94

  let function inc (x:int) : int
    requires { word x }
    ensures  { word result }
    ensures  { result = mod (x + 1) modulus }
  = mod (x + 1) modulus

  let function crazy10 (a:int) (d:int) : int
    requires { word a /\ word d }
    ensures  { word result }
  =
    let a0 = mod a 3 in
    let d0 = mod d 3 in
    let a1 = mod (div a 3) 3 in
    let d1 = mod (div d 3) 3 in
    let a2 = mod (div a 9) 3 in
    let d2 = mod (div d 9) 3 in
    let a3 = mod (div a 27) 3 in
    let d3 = mod (div d 27) 3 in
    let a4 = mod (div a 81) 3 in
    let d4 = mod (div d 81) 3 in
    let a5 = mod (div a 243) 3 in
    let d5 = mod (div d 243) 3 in
    let a6 = mod (div a 729) 3 in
    let d6 = mod (div d 729) 3 in
    let a7 = mod (div a 2187) 3 in
    let d7 = mod (div d 2187) 3 in
    let a8 = mod (div a 6561) 3 in
    let d8 = mod (div d 6561) 3 in
    let a9 = mod (div a 19683) 3 in
    let d9 = mod (div d 19683) 3 in
      crazy_trit a0 d0
    + 3 * crazy_trit a1 d1
    + 9 * crazy_trit a2 d2
    + 27 * crazy_trit a3 d3
    + 81 * crazy_trit a4 d4
    + 243 * crazy_trit a5 d5
    + 729 * crazy_trit a6 d6
    + 2187 * crazy_trit a7 d7
    + 6561 * crazy_trit a8 d8
    + 19683 * crazy_trit a9 d9
end
