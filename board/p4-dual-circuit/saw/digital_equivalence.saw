import "../cryptol/State.cry";
import "../cryptol/CircuitContract.cry";

let prove_state_invariants = do {
    print "Proving State.run_implies_locked...";
    prove_print z3 {{ run_implies_locked }};

    print "Proving CircuitContract.sram_write_protected...";
    prove_print z3 {{ sram_write_protected }};
};

// RTL check: SAW cannot check the clocked controller. yosys_import
// models each module as a combinational function from input ports to
// output ports (SAW manual ch. 6), and the $dff netlist is rejected
// at import as an undetected cycle (measured 2026-11-21 on a minimal
// $dff probe). The RTL check is the GHDL testbench
// verification/tb_p4_controller.vhd, run by `make test` in
// board/p4-dual-circuit/. The netlist target in that Makefile exists
// for future tooling, not for a SAW check that cannot run.
